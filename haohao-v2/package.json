{
  "name": "haohao-v2",
  "productName": "HaoHao V2",
  "version": "2.0.0",
  "description": "HaoHao V2 – trợ lý trên máy tính Windows, dùng chung dữ liệu với tiện ích HaoHao trên Chrome",
  "author": "Phan Thanh Nhật",
  "copyright": "© 2026 HaoHao – Phan Thanh Nhật",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "vn.haohao.v2",
    "productName": "HaoHao V2",
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "./build/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "HaoHao-V2-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HaoHao V2",
      "runAfterFinish": true,
      "language": "1066"
    }
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "26.0.12",
    "resedit": "2.0.3"
  }
}