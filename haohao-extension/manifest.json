{
  "manifest_version": 3,
  "name": "HaoHao – trợ lý ngay trên Chrome",
  "version": "2.30.0",
  "description": "Chú hamster trợ lý: Nhắc, Todo, Note, Focus, Dịch – Tóm tắt – Giải thích, kiểm tra hàng & mã giảm giá Shopee, TikTok Shop, canh email.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "system.display",
    "identity",
    "contextMenus",
    "search",
    "topSites",
    "favicon",
    "geolocation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://api.dexscreener.com/*",
    "http://127.0.0.1:47321/*",
    "https://mail.google.com/*",
    "https://graph.microsoft.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://vt.tiktok.com/*",
    "https://vm.tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://ipwho.is/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adhide.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "yt-ads.js"
      ],
      "run_at": "document_start"
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Mở cài đặt HaoHao"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  }
}
