{
  "manifest_version": 3,
  "name": "HaoHao – trợ lý ngay trên Chrome",
  "version": "2.2.0",
  "description": "Chú hamster trợ lý: Nhắc, Todo, Note, Focus, Dịch – Tóm tắt – Giải thích, Mua sắm, Tìm kiếm chung, canh email.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "system.display",
    "identity",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://api.dexscreener.com/*",
    "http://127.0.0.1:47321/*",
    "https://mail.google.com/*",
    "https://graph.microsoft.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://tiki.vn/*",
    "https://www.lazada.vn/*",
    "https://www.thegioididong.com/*",
    "https://www.dienmayxanh.com/*",
    "https://cellphones.com.vn/*",
    "https://fptshop.com.vn/*",
    "https://hasaki.vn/*",
    "https://www.sendo.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Mở cài đặt HaoHao"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "omnibox": {
    "keyword": "hh"
  }
}
